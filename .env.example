# ── Supabase ──────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Flask ─────────────────────────────────────────
FLASK_SECRET_KEY=generate-a-64-char-random-hex-string
FLASK_ENV=development
FLASK_DEBUG=1

# ── WhatsApp (stub — replace with Meta Business API) ──
WHATSAPP_API_KEY=placeholder-not-active
WHATSAPP_PHONE_NUMBER=+91XXXXXXXXXX

# ── Rate Limiter Storage (use redis:// in production) ──
RATELIMIT_STORAGE_URI=memory://
